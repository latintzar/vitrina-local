{
  "name": "vitrina-local",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "apps/*",
    "apps/*/*",
    "packages/*"
  ],
  "scripts": {
    "build": "pnpm --filter @scope/vitrina-web build",
    "dev": "pnpm --filter @scope/vitrina-web dev",
    "test": "pnpm --filter @scope/vitrina-web test",
    "lint": "pnpm --filter @scope/vitrina-web exec tsc -b --pretty false"
  },
  "pnpm": {
    "overrides": {
      "dompurify": "3.4.17",
      "@ai-sdk/provider-utils@4.0.23": "4.0.33",
      "@opentelemetry/core@2.2.0": "2.8.0",
      "@opentelemetry/core@2.7.0": "2.8.0",
      "@protobufjs/utf8@1.1.0": "1.1.1",
      "fflate@0.4.8": "0.4.9",
      "form-data@4.0.5": "4.0.6",
      "nanoid@3.3.11": "3.3.18",
      "postcss@8.5.10": "8.5.23",
      "protobufjs@7.5.5": "7.6.5",
      "source-map-js@1.2.1": "1.2.2",
      "ws@8.20.0": "8.21.0",
      "zod@4.3.6": "4.6.6",
      "esbuild@0.27.7": "0.28.1"
    }
  }
}
